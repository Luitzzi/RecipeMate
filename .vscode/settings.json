{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.hg": true,
        "**/.svn": true,
        "**/.venv": true,
        "**/node_modules": true,
        "**/Thumbs.db": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.playwright-mcp": true,
    },
    "java.compile.nullAnalysis.mode": "automatic",
    "explorer.fileNesting.patterns": {
        "compose.yaml": "compose.*.yaml",
    },
    "java.configuration.updateBuildConfiguration": "interactive"
}