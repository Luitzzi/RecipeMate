# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=example
POSTGRES_USER=example
POSTGRES_PASSWORD=REPLACEME

# Spring AI
ANTHROPIC_API_KEY=REPLACEME

# S3 object storage (dev: local Garage from compose.yaml)
# The values below are fixed dev-only credentials. Garage creates the key and bucket with them on startup.
# Access key format: GK + 24 hex chars, secret key: 64 hex chars.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=REPLACEME
S3_SECRET_KEY=REPLACEME
S3_BUCKET_NAME=recipemate-images

# Garage (dev only)
GARAGE_RPC_SECRET=REPLACEME
GARAGE_ADMIN_TOKEN=REPLACEME